# Copy to .env (never commit .env)

# HTTP port the Go API listens on (frontend's API_URL must point here)
PORT=8080

# Frontend origin allowed by CORS
APP_URL=http://localhost:3000

# Supabase — service role key bypasses RLS, keep it server-side only
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT signing secret (same value as the old Node API keeps existing sessions valid)
JWT_SECRET=your-secret-key-min-32-characters-long

# Google sign-in (optional). OAuth client id of type "Web application" from
# https://console.cloud.google.com/apis/credentials — add http://localhost:3000
# and http://localhost:3001 as Authorized JavaScript origins. Empty = button hidden.
GOOGLE_CLIENT_ID=

# Email for sign-in codes (two-step login). Gmail: host smtp.gmail.com, port 587,
# username = your Gmail address, password = an App Password
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification).
# Empty SMTP_HOST = codes are printed to the API log instead (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TechXStudio <your-address@gmail.com>
