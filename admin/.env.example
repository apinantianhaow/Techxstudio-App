# Copy to .env.local (never commit it)

# Go API server (../backend in this repo). Every /api/*
# request from the admin app is proxied there.
API_URL=http://localhost:8080

# Storefront origin: used for "View in store" links and to preview product
# images stored as /images/... in the storefront's public/ folder.
NEXT_PUBLIC_STORE_URL=http://localhost:3000
