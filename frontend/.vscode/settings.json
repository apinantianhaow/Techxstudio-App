{
  "css.validate": false,
  "css.lint.unknownAtRules": "ignore",
  "editor.quickSuggestions": {
    "strings": true
  },
  "tailwindCSS.experimental.classRegex": [
    ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "files.associations": {
    "*.css": "tailwindcss",
    "*.sql": "postgres"
  },
  "mssql.intelliSense.enableIntelliSense": false,
  "[sql]": {
    "editor.defaultFormatter": null
  }
}
